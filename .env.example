# ─────────────────────────────────────────────────────────────
# Trimly – Environment variables
# Copy this file to `.env.local` and fill in real values.
# NEXT_PUBLIC_* are exposed to the browser. Everything else is server-only.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Project URL + anon (public) key: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (SERVER ONLY – never expose to the client!):
# Supabase Dashboard → Project Settings → API → service_role secret.
# Used by server code to resolve redirects / write clicks bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────
# Public base URL used to build short links (no trailing slash).
# Local dev: http://localhost:3000  | Prod: https://trimly.iamharsh.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Upstash Redis (caching + rate limiting) ───────────────────
# Create a database at https://console.upstash.com/ → Redis → Details → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
